        <activity android:name=".PersonalCenterActivity" android:exported="false"/>
        <activity android:name=".SettingActivity" android:exported="false"/>
        <activity android:name=".MyOrderActivity" android:exported="false"/>
        <activity android:name=".CreateOrderActivity" android:exported="false"/>
