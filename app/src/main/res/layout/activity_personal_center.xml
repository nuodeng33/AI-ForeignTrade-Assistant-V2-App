<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gray_100">

    <!-- 标题栏（仅保留返回+标题+设置） -->
    <LinearLayout
        android:id="@+id/title_bar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/blue_700"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:layout_alignParentTop="true">

        <!-- 标题（居中） -->
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="个人中心"
            android:textSize="18sp"
            android:textColor="@color/white"
            android:gravity="center"/>

        <!-- 设置按钮 -->
        <ImageView
            android:id="@+id/iv_setting"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/bg25"
            android:contentDescription="设置"
            android:clickable="true"
            android:focusable="true"/>
    </LinearLayout>

    <!-- 底部导航栏 -->
    <include
        android:id="@+id/bottom_nav"
        layout="@layout/layout_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_alignParentBottom="true"/>

    <!-- 可滑动的内容区域 -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/title_bar"
        android:layout_above="@id/bottom_nav">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 顶部信息栏（包含头像+姓名+职位） -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:background="@color/blue_700"
                android:orientation="vertical"
                android:padding="16dp"
                android:gravity="center_horizontal|top"
                android:paddingTop="24dp"> <!-- 调整顶部内边距，避免被标题栏遮挡 -->

                <!-- 头像（完整显示） -->
                <ImageView
                    android:id="@+id/iv_avatar"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:background="@color/white"
                    android:padding="2dp"
                    android:src="@drawable/avatar1"
                    android:scaleType="centerCrop"
                    android:layout_marginBottom="12dp"/>

                <!-- 姓名 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="张明辉"
                    android:textSize="20sp"
                    android:id="@+id/user_name"
                    android:textColor="@color/white"/>

                <!-- 职位 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="外贸经理 | XX贸易有限公司"
                    android:textColor="@color/white_80"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- 统计卡片 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/white"
                android:orientation="horizontal"
                android:padding="16dp"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="-24dp"
                android:radius="8dp"
                android:elevation="2dp">

                <!-- 本月咨询 -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/tv_month_consult_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="28"
                        android:textSize="24sp"
                        android:textColor="@color/blue_500"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="本月咨询"
                        android:textSize="14sp"
                        android:textColor="@color/gray_600"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>

                <!-- 进行中订单 -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/tv_ongoing_order_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="4"
                        android:textSize="24sp"
                        android:textColor="@color/blue_500"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="进行中订单"
                        android:textSize="14sp"
                        android:textColor="@color/gray_600"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- 数据图表区域（替换为MPAndroidChart的BarChart） -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:background="@color/white"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_margin="16dp"
                android:layout_marginTop="12dp"
                android:radius="8dp">

                <!-- 图表标题 -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="咨询类型统计"
                    android:textSize="16sp"
                    android:textColor="@color/black"
                    android:layout_marginBottom="8dp"/>

                <!-- 柱状图控件 -->
                <com.github.mikephil.charting.charts.BarChart
                    android:id="@+id/bar_chart_consult_type"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"/>
            </LinearLayout>

            <!-- 服务管理 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/white"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginHorizontal="16dp"
                android:radius="8dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="服务管理"
                    android:textSize="18sp"
                    android:textColor="@color/black"
                    android:layout_marginBottom="16dp"/>

                <!-- 我的订单 -->
                <LinearLayout
                    android:id="@+id/ll_order"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="8dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/bg24"
                        android:contentDescription="订单"/>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="我的订单"
                        android:textSize="16sp"
                        android:textColor="@color/black"
                        android:layout_marginStart="16dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="查看所有服务订单状态"
                        android:textSize="14sp"
                        android:textColor="@color/gray_600"
                        android:layout_marginEnd="16dp"/>
                </LinearLayout>

                <!-- 账单与支付 -->
                <LinearLayout
                    android:id="@+id/ll_bill"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="8dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/bg21"
                        android:contentDescription="账单"/>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="账单与支付"
                        android:textSize="16sp"
                        android:textColor="@color/black"
                        android:layout_marginStart="16dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="查看账单及支付记录"
                        android:textSize="14sp"
                        android:textColor="@color/gray_600"
                        android:layout_marginEnd="16dp"/>
                </LinearLayout>

                <!-- 我的收藏 -->
                <LinearLayout
                    android:id="@+id/ll_collect"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="8dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/bg22"
                        android:contentDescription="收藏"/>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="我的收藏"
                        android:textSize="16sp"
                        android:textColor="@color/black"
                        android:layout_marginStart="16dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="查看已收藏的服务内容"
                        android:textSize="14sp"
                        android:textColor="@color/gray_600"
                        android:layout_marginEnd="16dp"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

</RelativeLayout>